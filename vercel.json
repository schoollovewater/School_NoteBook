{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/school/mini", "destination": "/mini.html?user=school" },
    { "source": "/school/mini/(.*)", "destination": "/mini.html?user=school" },
    { "source": "/water/mini", "destination": "/mini.html?user=water" },
    { "source": "/water/mini/(.*)", "destination": "/mini.html?user=water" },
    { "source": "/school", "destination": "/app.html?user=school" },
    { "source": "/school/(.*)", "destination": "/app.html?user=school" },
    { "source": "/water", "destination": "/app.html?user=water" },
    { "source": "/water/(.*)", "destination": "/app.html?user=water" },
    { "source": "/mini", "destination": "/mini.html" }
  ]
}
